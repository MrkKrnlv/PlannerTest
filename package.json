{
  "name": "planner",
  "version": "1.0.0",
  "scripts": {
    "dev": "vite",
    "dev:api": "wrangler pages dev dist --port 8788",
    "build": "vite build",
    "preview": "npm run build && wrangler pages dev dist --port 8788",
    "db:migrate:local": "wrangler d1 migrations apply planner --local",
    "db:migrate": "wrangler d1 migrations apply planner --remote",
    "deploy": "npm run build && wrangler pages deploy dist",
    "test:api": "node scripts/smoke-test.mjs"
  },
  "dependencies": {
    "@fontsource-variable/onest": "^5.3.1",
    "@fontsource-variable/unbounded": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.2",
    "vite": "^8.3.4",
    "wrangler": "^4.151.0"
  },
  "private": true,
  "type": "module"
}

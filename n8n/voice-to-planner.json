{
  "id": "voiceToPlanner01",
  "name": "Голос → Планер",
  "nodes": [
    {
      "id": "fd2da025-00d8-41db-b5d3-9f2f755f7b39",
      "name": "Telegram Trigger",
      "type": "n8n-nodes-base.telegramTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        300
      ],
      "parameters": {
        "updates": [
          "message"
        ],
        "additionalFields": {}
      }
    },
    {
      "id": "e3455a99-acd0-4416-959d-acd23dff95b7",
      "name": "Голосовое?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        220,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "0632af47-f3bc-4859-a708-996dc3691331",
              "leftValue": "={{ $json.message.voice }}",
              "operator": {
                "type": "object",
                "operation": "exists",
                "singleValue": true
              },
              "rightValue": ""
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "01dd9a6b-e88e-44dd-a37d-0932eb156857",
      "name": "Скачать голосовое",

        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-telegram-user-id",
              "value": "={{ $('Telegram Trigger').item.json.message.from.id }}"
            }

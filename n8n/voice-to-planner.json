      "typeVersion": 1.2,
      "position": [
        440,
        200
      ],
      "parameters": {
        "resource": "file",
        "fileId": "={{ $json.message.voice.file_id }}",
        "additionalFields": {}
      }
    },
    {
      "id": "7be09897-02e0-49d5-938b-99a0a28908ee",
      "name": "Расшифровать (Groq Whisper)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        660,
        200
      ],
      "parameters": {
        "method": "POST",
        "url": "https://api.groq.com/openai/v1/audio/transcriptions",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "groqApi",
        "sendBody": true,
        "contentType": "multipart-form-data",
        "bodyParameters": {
          "parameters": [
            {
              "parameterType": "formBinaryData",
              "name": "file",
              "inputDataFieldName": "data"
            },
            {
              "name": "model",
              "value": "whisper-large-v3-turbo"
            },
            {
              "name": "language",
              "value": "ru"
            },
            {
              "name": "response_format",
              "value": "json"
            }
          ]
        },
        "options": {}
      },
      "credentials": {
        "groqApi": {
          "name": "Groq"
        }
      }
    },
    {
      "id": "abe14c5f-fc2a-402f-9341-6e9e68d2eabe",
      "name": "Текст",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        880,
        300
      ],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "b6f1880a-34de-4e23-b529-cf7eb230441e",
              "name": "text",
              "type": "string",
              "value": "={{ $json.text ?? $('Telegram Trigger').item.json.message.text ?? '' }}"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "4eafbd4b-932e-4372-bb71-dd12511c123f",
      "name": "Задачи на неделю",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1100,
        300
      ],
      "parameters": {
        "url": "https://plannertest.marksohokornilov.workers.dev/api/tasks",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-telegram-user-id",
              "value": "={{ $('Telegram Trigger').item.json.message.from.id }}"
            }
          ]
        },
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "from",
              "value": "={{ $now.setZone('Europe/Moscow').toFormat('yyyy-MM-dd') }}"
            },
            {
              "name": "to",
              "value": "={{ $now.setZone('Europe/Moscow').plus({ days: 6 }).toFormat('yyyy-MM-dd') }}"
            }
          ]
        },
        "options": {}
      },
      "credentials": {
        "httpHeaderAuth": {
          "name": "Planner service key"
        }
      }
    },
    {
      "id": "489287b8-d6b5-45d3-aeeb-6013418eb5e7",
      "name": "AI Agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 2,
      "position": [
        1320,
        300
      ],
      "parameters": {
        "promptType": "define",
        "text": "=Сегодня: {{ $now.setZone('Europe/Moscow').setLocale('ru').toFormat('yyyy-MM-dd, cccc') }}.\n\nУже запланировано на 7 дней:\n{{ JSON.stringify($('Задачи на неделю').item.json.tasks) }}\n\nСообщение пользователя:\n{{ $('Текст').item.json.text }}",
        "hasOutputParser": true,
        "options": {
          "systemMessage": "Ты — ассистент-планировщик. Из сообщения пользователя (часто это расшифровка голосового, с ошибками распознавания) извлекаешь задачи для планера.\n\nПравила:\n- Дата: если не названа — сегодня. «Завтра», «в пятницу», «на выходных» переводи в конкретную ближайшую будущую дату.\n- time ставь только если время названо явно. slot: morning до 12:00, afternoon 12–17, evening после 17. Если неясно — anytime.\n- duration_min: если длительность не сказана, оцени реалистично и кратно 5 (звонок 15–30, встреча 60, монтаж/код/учёба 90–180, бытовая мелочь 10–20).\n- Размытую большую задачу («разобраться с сайтом») разбей на 2–3 конкретных шага.\n- priority: 1 — если сказано «срочно», «важно», «обязательно» или есть жёсткий дедлайн; 3 — «если успею», «когда-нибудь»; иначе 2.\n- area: одно короткое слово из списка: работа, учёба, здоровье, люди, дом, творчество — только если очевидно из контекста.\n- deep: true для задач, требующих концентрации (код, монтаж, тексты, учёба) от 60 минут. Такие задачи планер ставит в пик энергии.\n- frog: true максимум для одной задачи на день — самой важной, если пользователь так её обозначил («главное», «в первую очередь»).\n- Учитывай уже запланированные задачи: не ставь новую на занятое время. Если день выходит больше 8 часов, перенеси некритичное (priority 3) на следующий день и скажи об этом в summary.\n- Не выдумывай задачи. Если в сообщении задач нет (приветствие, вопрос, /start), верни пустой tasks и коротко ответь в summary, что умеешь.\n- summary пиши на «ты», по-русски, без смайликов: что добавил и на какие дни."
        }
      }
    },
    {
      "id": "05c0e4ed-5fda-4e64-a085-d26d8d09057c",
      "name": "Groq Chat Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatGroq",
      "typeVersion": 1,
      "position": [
        1260,
        520
      ],
      "parameters": {
        "model": "openai/gpt-oss-120b",
        "options": {
          "temperature": 0.2
        }
      },
      "credentials": {
        "groqApi": {
          "name": "Groq"
        }
      }
    },
    {
      "id": "ec3412c9-3c10-4654-bae1-dafc2c299f8c",
      "name": "Structured Output Parser",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.3,
      "position": [
        1440,
        520
      ],
      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"tasks\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"title\": {\n            \"type\": \"string\",\n            \"description\": \"Коротко, с глагола: «Позвонить Ане»\"\n          },\n          \"date\": {\n            \"type\": \"string\",\n            \"description\": \"YYYY-MM-DD\"\n          },\n          \"time\": {\n            \"type\": [\n              \"string\",\n              \"null\"\n            ],\n            \"description\": \"HH:MM, только если время названо\"\n          },\n          \"duration_min\": {\n            \"type\": \"integer\",\n            \"description\": \"Оценка в минутах, кратно 5\"\n          },\n          \"slot\": {\n            \"type\": \"string\",\n            \"enum\": [\n              \"morning\",\n              \"afternoon\",\n              \"evening\",\n              \"anytime\"\n            ]\n          },\n          \"area\": {\n            \"type\": [\n              \"string\",\n              \"null\"\n            ],\n            \"description\": \"работа, учёба, дом, здоровье, клиенты\"\n          },\n          \"priority\": {\n            \"type\": \"integer\",\n            \"minimum\": 1,\n            \"maximum\": 3\n          },\n          \"deep\": {\n            \"type\": \"boolean\",\n            \"description\": \"Глубокая работа: требует концентрации, от 60 минут\"\n          },\n          \"frog\": {\n            \"type\": \"boolean\",\n            \"description\": \"Главная задача дня, максимум одна на день\"\n          }\n        },\n        \"required\": [\n          \"title\",\n          \"date\",\n          \"duration_min\",\n          \"slot\",\n          \"priority\"\n        ]\n      }\n    },\n    \"summary\": {\n      \"type\": \"string\",\n      \"description\": \"1–3 предложения пользователю: что и куда добавлено\"\n    }\n  },\n  \"required\": [\n    \"tasks\",\n    \"summary\"\n  ]\n}"
      }
    },
    {
      "id": "e5cbb6f3-0b0b-40a9-a564-a95dd68c4314",
      "name": "Есть задачи?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,

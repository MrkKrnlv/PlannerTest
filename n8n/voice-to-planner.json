      "parameters": {
        "method": "POST",
        "url": "https://YOUR-APP.pages.dev/api/tasks",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-telegram-user-id",
              "value": "={{ $('Telegram Trigger').item.json.message.from.id }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ source: 'voice', tasks: $json.output.tasks }) }}",
        "options": {}
      },
      "credentials": {
        "httpHeaderAuth": {
          "name": "Planner service key"
        }
      }
    },
    {
      "id": "145f395a-6e78-44ee-9925-51480a4311b5",
      "name": "Ответить в Telegram",
      "type": "n8n-nodes-base.telegram",

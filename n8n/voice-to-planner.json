{
  "name": "Голос → Планер",
  "nodes": [
    {
      "id": "1ebc5929-73c2-40fb-bc44-0da958a4db75",
      "name": "Telegram Trigger",
      "type": "n8n-nodes-base.telegramTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        300
      ],
      "parameters": {
        "updates": [
          "message"
        ],
        "additionalFields": {}
      }
    },
    {
      "id": "d93d8fc1-b751-4ceb-abea-247cf7dafe40",
      "name": "Голосовое?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        220,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "e038737c-5166-4036-8f0c-c905ff7ad76f",
              "leftValue": "={{ $json.message.voice }}",
              "operator": {
                "type": "object",
                "operation": "exists",
                "singleValue": true
              },
              "rightValue": ""
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "9912f46a-a0b1-4f97-919e-b6a2db8ec2e1",
      "name": "Скачать голосовое",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        440,
        200
      ],
      "parameters": {
        "resource": "file",
        "fileId": "={{ $json.message.voice.file_id }}",
        "additionalFields": {}
      }
    },
    {
      "id": "4da4698b-fa7f-4f0f-bd33-d00c7450430f",
      "name": "Расшифровать",
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "typeVersion": 1.8,
      "position": [
        660,
        200
      ],
      "parameters": {
        "resource": "audio",
        "operation": "transcribe",
        "options": {
          "language": "ru"
        }
      }
    },
    {
      "id": "1d4a8501-03c5-42f4-80c7-43c4466f2e9c",
      "name": "Текст",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        880,
        300
      ],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "9a225e8d-f654-439d-bf93-e43b5ae9d057",
              "name": "text",
              "type": "string",
              "value": "={{ $json.text ?? $('Telegram Trigger').item.json.message.text ?? '' }}"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "8a87820d-7955-44a0-953c-ed2b318c129f",
      "name": "Задачи на неделю",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1100,
        300
      ],
      "parameters": {
        "url": "https://YOUR-APP.pages.dev/api/tasks",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-telegram-user-id",
              "value": "={{ $('Telegram Trigger').item.json.message.from.id }}"
            }
          ]
        },
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "from",
              "value": "={{ $now.setZone('Europe/Moscow').toFormat('yyyy-MM-dd') }}"
            },
            {
              "name": "to",
              "value": "={{ $now.setZone('Europe/Moscow').plus({ days: 6 }).toFormat('yyyy-MM-dd') }}"
            }
          ]
        },
        "options": {}
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "",
          "name": "Planner service key"
        }
      }
    },
    {
      "id": "5bc39b1f-6c3e-4120-a019-08e014935c29",
      "name": "AI Agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 2,
      "position": [
        1320,
        300
      ],
      "parameters": {
        "promptType": "define",
        "text": "=Сегодня: {{ $now.setZone('Europe/Moscow').setLocale('ru').toFormat('yyyy-MM-dd, cccc') }}.\n\nУже запланировано на 7 дней:\n{{ JSON.stringify($('Задачи на неделю').item.json.tasks) }}\n\nСообщение пользователя:\n{{ $('Текст').item.json.text }}",
        "hasOutputParser": true,
        "options": {
          "systemMessage": "Ты — ассистент-планировщик. Из сообщения пользователя (часто это расшифровка голосового, с ошибками распознавания) извлекаешь задачи для планера.\n\nПравила:\n- Дата: если не названа — сегодня. «Завтра», «в пятницу», «на выходных» переводи в конкретную ближайшую будущую дату.\n- time ставь только если время названо явно. slot: morning до 12:00, afternoon 12–17, evening после 17. Если неясно — anytime.\n- duration_min: если длительность не сказана, оцени реалистично и кратно 5 (звонок 15–30, встреча 60, монтаж/код/учёба 90–180, бытовая мелочь 10–20).\n- Размытую большую задачу («разобраться с сайтом») разбей на 2–3 конкретных шага.\n- priority: 1 — если сказано «срочно», «важно», «обязательно» или есть жёсткий дедлайн; 3 — «если успею», «когда-нибудь»; иначе 2.\n- area: одно короткое слово, только если очевидно из контекста.\n- Учитывай уже запланированные задачи: не ставь новую на занятое время. Если день выходит больше 8 часов, перенеси некритичное (priority 3) на следующий день и скажи об этом в summary.\n- Не выдумывай задачи. Если в сообщении задач нет (приветствие, вопрос, /start), верни пустой tasks и коротко ответь в summary, что умеешь.\n- summary пиши на «ты», по-русски, без смайликов: что добавил и на какие дни."
        }
      }
    },
    {
      "id": "1896fdff-2d61-49fb-858d-fc3a4e3b20e7",
      "name": "OpenAI Chat Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.2,
      "position": [
        1260,
        520
      ],
      "parameters": {
        "model": {
          "__rl": true,
          "value": "gpt-4.1-mini",
          "mode": "list",
          "cachedResultName": "gpt-4.1-mini"
        },
        "options": {
          "temperature": 0.2
        }
      }
    },
    {
      "id": "53bcb0b0-410b-4c39-9bd4-9be9782c2832",
      "name": "Structured Output Parser",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.3,
      "position": [
        1440,
        520
      ],
      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"tasks\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"title\": {\n            \"type\": \"string\",\n            \"description\": \"Коротко, с глагола: «Позвонить Ане»\"\n          },\n          \"date\": {\n            \"type\": \"string\",\n            \"description\": \"YYYY-MM-DD\"\n          },\n          \"time\": {\n            \"type\": [\n              \"string\",\n              \"null\"\n            ],\n            \"description\": \"HH:MM, только если время названо\"\n          },\n          \"duration_min\": {\n            \"type\": \"integer\",\n            \"description\": \"Оценка в минутах, кратно 5\"\n          },\n          \"slot\": {\n            \"type\": \"string\",\n            \"enum\": [\n              \"morning\",\n              \"afternoon\",\n              \"evening\",\n              \"anytime\"\n            ]\n          },\n          \"area\": {\n            \"type\": [\n              \"string\",\n              \"null\"\n            ],\n            \"description\": \"работа, учёба, дом, здоровье, клиенты\"\n          },\n          \"priority\": {\n            \"type\": \"integer\",\n            \"minimum\": 1,\n            \"maximum\": 3\n          }\n        },\n        \"required\": [\n          \"title\",\n          \"date\",\n          \"duration_min\",\n          \"slot\",\n          \"priority\"\n        ]\n      }\n    },\n    \"summary\": {\n      \"type\": \"string\",\n      \"description\": \"1–3 предложения пользователю: что и куда добавлено\"\n    }\n  },\n  \"required\": [\n    \"tasks\",\n    \"summary\"\n  ]\n}"
      }
    },
    {
      "id": "d77e5d8f-0d90-4dcf-8bac-7e7637f427bd",
      "name": "Есть задачи?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1640,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "1ff34e05-55fa-49d8-9790-bf7dd0c7733d",
              "leftValue": "={{ $json.output.tasks.length }}",
              "operator": {
                "type": "number",
                "operation": "gt"
              },
              "rightValue": 0
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "156607f0-f625-483e-bae0-d5bb2f337c73",

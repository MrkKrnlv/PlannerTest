      "parameters": {
        "method": "POST",
        "url": "https://plannertest.marksohokornilov.workers.dev/api/tasks",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-telegram-user-id",
              "value": "={{ $('Telegram Trigger').item.json.message.from.id }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ source: 'voice', tasks: $json.output.tasks }) }}",
        "options": {}
      },
      "credentials": {
        "httpHeaderAuth": {
          "name": "Planner service key"
        }
      }
    },
    {
      "id": "6038c099-b19f-4a2c-b759-1bac632684c5",
      "name": "Ответить в Telegram",
      "type": "n8n-nodes-base.telegram",
